{
  "name": "techon-erp",
  "private": true,
  "version": "2.0.0",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite --host 127.0.0.1 --port 5173\" \"wait-on http://127.0.0.1:5173 && cross-env ELECTRON_VITE=1 electron .\"",
    "electron": "electron .",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "dist": "electron-builder",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "audit:high": "npm audit --audit-level=high",
    "test:accounting": "node scripts/accounting-tests/run.mjs",
    "test:erp": "node scripts/erp-tests/run.mjs",
    "ci:scan-secrets": "node scripts/ci-scan-secrets.mjs",
    "release:check": "npm run ci",
    "release:gate": "npm run ci && node scripts/release-gate.mjs",
    "ci": "npm run typecheck && npm run audit:high && npm run ci:scan-secrets && npm run test:accounting && npm run test:erp && npm run build"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "node-fetch": "^3.3.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.techon.erp",
    "productName": "Techon-ERP",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "preload.js",
      "icons/**/*",
      "splash.html",
      "splash.png",
      "tc_license_secret.txt.example"
    ],
    "extraResources": [
      {
        "from": "tc_license_secret.txt.example",
        "to": "tc_license_secret.txt.example"
      },
      {
        "from": "network-api",
        "to": "network-api"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icons/techonERP.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Techon ERP",
      "installerIcon": "icons/techonERP.ico",
      "uninstallerIcon": "icons/techonERP.ico",
      "installerHeaderIcon": "icons/techonERP.ico",
      "installerSidebar": "build/installer.bmp",
      "uninstallerSidebar": "build/installer.bmp",
      "license": "build/license.txt"
    }
  }
}
