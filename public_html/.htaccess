

RewriteEngine On

# ✅ Allow downloads folder
RewriteCond %{REQUEST_URI} ^/downloads/
RewriteRule ^ - [L]

# ✅ Allow existing files and directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ✅ React SPA fallback
RewriteRule ^ /site/index.html [L]

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php84” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php84___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
