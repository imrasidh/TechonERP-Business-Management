# Techon ERP License Server — Apache config
# Upload this to https://license.techon.lk/

# Block direct access to the database file
<Files "licenses.json">
    Order allow,deny
    Deny from all
</Files>

# Only allow POST requests to PHP endpoints (optional extra hardening)
# Force HTTPS if available
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php84” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php84___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
